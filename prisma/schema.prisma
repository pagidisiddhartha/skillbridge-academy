// SkillBridge Academy - Production Prisma Schema
// Database Engine: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  TEXT
  VIDEO
  QUIZ
  ASSIGNMENT
  RESOURCE
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum InternshipStatus {
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_REVISION
  APPROVED
}

enum CertificateStatus {
  VALID
  REVOKED
}

enum Priority {
  NORMAL
  IMPORTANT
  URGENT
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  avatar        String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile       StudentProfile?
  mentorProfile        MentorProfile?
  enrollments          Enrollment[]
  lessonProgresses     LessonProgress[]
  quizAttempts         QuizAttempt[]
  submissions          ProjectSubmission[]
  mentorFeedbacks      MentorFeedback[]
  applications         InternshipApplication[]
  resumes              ResumeDocument[]
  certificates         Certificate[]
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@index([email])
  @@index([role])
}

model StudentProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  university       String?
  major            String?
  graduationYear   Int?
  phone            String?
  githubUrl        String?
  linkedinUrl      String?
  portfolioUrl     String?
  skills           String[] @default([])
  resumeFileName   String?
  resumeDataUrl    String?
  assignedMentorId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MentorProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  company            String
  jobTitle           String
  expertise          String[] @default([])
  yearsExperience    Int      @default(0)
  assignedStudentIds String[] @default([])
  bio                String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Course {
  id               String       @id @default(uuid())
  title            String
  slug             String       @unique
  shortDescription String
  description      String
  category         String
  difficulty       Difficulty   @default(INTERMEDIATE)
  instructor       String
  instructorAvatar String?
  instructorBio    String?
  thumbnail        String
  durationHours    Int          @default(20)
  learningOutcomes String[]     @default([])
  prerequisites    String[]     @default([])
  published        Boolean      @default(false)
  featured         Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  modules          CourseModule[]
  enrollments      Enrollment[]
  lessonProgresses LessonProgress[]
  projects         Project[]

  @@index([category])
  @@index([published])
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String
  orderIndex  Int      @default(1)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
  @@index([orderIndex])
}

model Lesson {
  id               String     @id @default(uuid())
  moduleId         String
  courseId         String
  title            String
  type             LessonType @default(TEXT)
  durationMinutes  Int        @default(15)
  orderIndex       Int        @default(1)
  content          String
  videoUrl         String?
  assignmentPrompt String?

  module           CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizzes          Quiz[]
  assignments      Assignment[]
  lessonProgresses LessonProgress[]

  @@index([moduleId])
  @@index([courseId])
}

model Enrollment {
  id              String   @id @default(uuid())
  userId          String
  courseId        String
  enrolledAt      DateTime @default(now())
  progressPercent Int      @default(0)
  completedAt     DateTime?
  status          String   @default("active")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  courseId    String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, courseId])
}

model Quiz {
  id                  String   @id @default(uuid())
  lessonId            String
  title               String
  passingScorePercent Int      @default(70)

  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@index([lessonId])
}

model Question {
  id                 String   @id @default(uuid())
  quizId             String
  questionText       String
  options            String[]
  correctOptionIndex Int
  explanation        String?

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id           String   @id @default(uuid())
  userId       String
  quizId       String
  scorePercent Int
  passed       Boolean
  answers      Int[]
  attemptedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
}

model Assignment {
  id           String @id @default(uuid())
  lessonId     String
  title        String
  instructions String
  maxPoints    Int    @default(100)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Project {
  id           String            @id @default(uuid())
  courseId     String?
  title        String
  description  String
  instructions String
  requirements String[]          @default([])
  deliverables String[]          @default([])
  deadline     DateTime
  createdAt    DateTime          @default(now())

  course      Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  milestones  ProjectMilestone[]
  submissions ProjectSubmission[]

  @@index([courseId])
}

model ProjectMilestone {
  id          String   @id @default(uuid())
  projectId   String
  title       String
  description String
  orderIndex  Int      @default(1)
  dueDate     DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectSubmission {
  id             String           @id @default(uuid())
  projectId      String
  milestoneId    String?
  studentId      String
  repoUrl        String
  demoUrl        String?
  notes          String
  status         SubmissionStatus @default(SUBMITTED)
  grade          Int?
  mentorFeedback String?
  mentorId       String?
  submittedAt    DateTime         @default(now())
  reviewedAt     DateTime?
  version        Int              @default(1)

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feedbacks MentorFeedback[]

  @@index([projectId])
  @@index([studentId])
}

model MentorFeedback {
  id                 String   @id @default(uuid())
  submissionId       String
  mentorId           String
  content            String
  rating             Int?
  revisionRequested  Boolean  @default(false)
  createdAt          DateTime @default(now())

  submission ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  mentor     User              @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Internship {
  id                 String           @id @default(uuid())
  title              String
  organization       String
  logo               String
  location           String
  workMode           WorkMode         @default(HYBRID)
  durationMonths     Int              @default(6)
  stipend            String
  description        String
  responsibilities   String[]         @default([])
  requiredSkills     String[]         @default([])
  eligibilityCriteria String[]        @default([])
  deadline           DateTime
  availablePositions Int              @default(1)
  status             InternshipStatus @default(PUBLISHED)
  featured           Boolean          @default(false)
  createdAt          DateTime         @default(now())

  applications InternshipApplication[]

  @@index([status])
  @@index([workMode])
}

model InternshipApplication {
  id               String            @id @default(uuid())
  internshipId     String
  studentId        String
  coverLetter      String
  resumeFileName   String
  resumeDataUrl    String?
  portfolioUrl     String?
  skills           String[]          @default([])
  additionalInfo   String?
  status           ApplicationStatus @default(APPLIED)
  appliedAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  reviewNotes      String?
  reviewedByUserId String?

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, internshipId])
  @@index([internshipId])
  @@index([studentId])
  @@index([status])
}

model ResumeDocument {
  id         String   @id @default(uuid())
  studentId  String
  fileName   String
  fileData   String
  uploadedAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Certificate {
  id              String            @id @default(uuid())
  certificateCode String            @unique
  studentId       String
  studentName     String
  title           String
  type            String            @default("course")
  completionDate  DateTime
  issuingOrg      String            @default("SkillBridge Academy")
  verificationUrl String
  status          CertificateStatus @default(VALID)
  grade           String?
  issuedByUserId  String

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([certificateCode])
  @@index([studentId])
}

model Announcement {
  id         String   @id @default(uuid())
  title      String
  content    String
  targetRole String   @default("all")
  priority   Priority @default(NORMAL)
  createdAt  DateTime @default(now())
  authorName String
  authorId   String

  @@index([targetRole])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  userEmail  String
  action     String
  entityType String
  entityId   String
  details    String
  ipAddress  String
  timestamp  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([timestamp])
}
